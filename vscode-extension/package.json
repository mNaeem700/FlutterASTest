{
  "name": "flutterastest",
  "displayName": "FlutterASTest",
  "description": "Generate and run Flutter widget tests from an AST-based Program Knowledge Graph.",
  "version": "1.0.0",
  "publisher": "mnaeem700",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mNaeem700/FlutterASTest"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Testing"],
  "main": "./extension.js",
  "activationEvents": ["workspaceContains:pubspec.yaml"],
  "contributes": {
    "commands": [
      {
        "command": "flutterastest.generateProject",
        "title": "FlutterASTest: Generate Tests for All Screens"
      },
      {
        "command": "flutterastest.generateFile",
        "title": "FlutterASTest: Generate Tests for Screens in This File"
      },
      {
        "command": "flutterastest.preview",
        "title": "FlutterASTest: Build Prompts Only (No LLM Calls)"
      },
      {
        "command": "flutterastest.openReport",
        "title": "FlutterASTest: Open Latest Report"
      },
      {
        "command": "flutterastest.setApiKey",
        "title": "FlutterASTest: Set API Key"
      },
      {
        "command": "flutterastest.selectProvider",
        "title": "FlutterASTest: Choose LLM Provider"
      },
      {
        "command": "flutterastest.doctor",
        "title": "FlutterASTest: Check Setup"
      },
      {
        "command": "flutterastest.refreshResults",
        "title": "FlutterASTest: Refresh Results",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "test": [
        {
          "id": "flutterastest.results",
          "name": "FlutterASTest"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "flutterastest.results",
        "contents": "No results yet.\n[Generate Tests](command:flutterastest.generateProject)\n[Check Setup](command:flutterastest.doctor)\nBy default your code stays on this machine."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flutterastest.refreshResults",
          "when": "view == flutterastest.results",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "flutterastest.generateFile",
          "when": "resourceLangId == dart",
          "group": "flutterastest"
        }
      ]
    },
    "configuration": {
      "title": "FlutterASTest",
      "properties": {
        "flutterastest.executable": {
          "type": "string",
          "default": "flutterastest",
          "description": "The FlutterASTest command. Install it with: dart pub global activate --source path <clone>"
        },
        "flutterastest.provider": {
          "type": "string",
          "enum": ["local", "gemini", "openai"],
          "default": "local",
          "enumDescriptions": [
            "A model on this machine, such as Ollama. Your code stays here.",
            "Google Gemini with your own key. Code is sent to Google.",
            "An OpenAI-compatible service with your own key. Code is sent to it."
          ],
          "description": "LLM provider."
        },
        "flutterastest.model": {
          "type": "string",
          "default": "",
          "description": "Model name. Required for the local provider (see 'ollama list')."
        },
        "flutterastest.reflect": {
          "type": "boolean",
          "default": true,
          "description": "Repair failing tests by feeding run results back to the LLM."
        },
        "flutterastest.flutterPath": {
          "type": "string",
          "default": "",
          "description": "Flutter to use. Empty detects it per project (its FVM SDK, then PATH)."
        }
      }
    }
  }
}
